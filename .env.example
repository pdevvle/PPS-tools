# QuickBooks Online — create an app at https://developer.intuit.com and copy these:
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Must exactly match the redirect URI registered on the Intuit app.
QBO_REDIRECT_URI=http://localhost:5000/oauth/callback

# "production" for real books, "sandbox" for testing against an Intuit sandbox company.
QBO_ENVIRONMENT=production

# Where OAuth tokens are cached locally (gitignored by default).
QBO_TOKEN_PATH=.qbo_tokens.json

# Anthropic API key for Claude-powered category suggestions.
ANTHROPIC_API_KEY=

# Optional: one-line description of your business — fed to Claude for better suggestions.
QBO_BUSINESS_CONTEXT=A small print services business (commercial printing, brochures, booklets, business cards).

# Flask session secret. If unset, a random key is generated on each start
# (which logs out OAuth sessions on restart, but tokens persist on disk).
FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# PPS Books — `pps books serve` (see docs/books.md)
# ---------------------------------------------------------------------------

# Where the database, attachments and session key live.
BOOKS_DATA_DIR=books-data

# The address customers and Stripe reach (pay links in emails, the webhook). Use https:// in production.
BOOKS_BASE_URL=http://localhost:5080

# Optional: a database URL instead of SQLite in the data folder.
# BOOKS_DATABASE_URL=

# Stripe: secret (or restricted) key and the signing secret of the webhook at <BOOKS_BASE_URL>/stripe/webhook.
# Keys saved under Settings → Payments are used when these are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Outgoing email for invoices, statements and reminders. Empty: emails wait in the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Claude model for categorizing bank transactions and reading receipts (uses ANTHROPIC_API_KEY above).
BOOKS_AI_MODEL=claude-opus-5-5
