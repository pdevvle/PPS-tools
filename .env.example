# QuickBooks Online — create an app at https://developer.intuit.com and copy these:
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Must exactly match the redirect URI registered on the Intuit app.
QBO_REDIRECT_URI=http://localhost:5000/oauth/callback

# "production" for real books, "sandbox" for testing against an Intuit sandbox company.
QBO_ENVIRONMENT=production

# Where OAuth tokens are cached locally (gitignored by default).
QBO_TOKEN_PATH=.qbo_tokens.json

# Anthropic API key for Claude-powered category suggestions.
ANTHROPIC_API_KEY=

# Optional: one-line description of your business — fed to Claude for better suggestions.
QBO_BUSINESS_CONTEXT=A small print services business (commercial printing, brochures, booklets, business cards).

# Flask session secret. If unset, a random key is generated on each start
# (which logs out OAuth sessions on restart, but tokens persist on disk).
FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Marketing Hub — `pps marketing serve` (see MARKETING_HUB.md for step-by-step setup)
# ---------------------------------------------------------------------------

# Address you open the hub at. Each platform's redirect URI is
# <MARKETING_BASE_URL>/oauth/<platform>/callback and must be registered with that platform.
MARKETING_BASE_URL=http://localhost:5050

# auto = sample data until the first platform is connected; on / off to force it.
MARKETING_DEMO=auto

# Where connections, posts, rules and budgets are stored (keep it private: it holds access tokens).
MARKETING_DB_PATH=marketing.db

# Set a password if anyone besides you can reach the hub.
MARKETING_APP_PASSWORD=

# Claude model for AI Studio and Insights (uses ANTHROPIC_API_KEY above).
MARKETING_CLAUDE_MODEL=claude-opus-5-5

# Optional: a few sentences about the business, used by AI Studio and Insights.
MARKETING_BRAND_CONTEXT=

# Rules and one-click AI suggestions never move a daily budget more than this % in one step.
MARKETING_MAX_BUDGET_CHANGE_PCT=50

# Google Ads — OAuth client from the Google Cloud project that has Google Ads API access.
# (Developer tokens were retired in 2026; access now comes from the Cloud project.)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional: your manager (MCC) account id, if you reach client accounts through one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta (Facebook + Instagram) — a Business app with Facebook Login and the Marketing API.
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration id (replaces the scope list).
META_LOGIN_CONFIG_ID=

# Pinterest — app from developers.pinterest.com (Standard access needed to publish publicly).
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# X (Twitter) — OAuth 2.0 client for posting (pay-per-use API credits required)...
X_CLIENT_ID=
X_CLIENT_SECRET=
# ...and OAuth 1.0a keys for the X Ads API (reporting + campaign control). These can also post.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# LinkedIn — app with the Advertising API and Community Management API products.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok for Business — Marketing API app (ads reporting + control).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Advanced: API versions (defaults are current as of October 2026).
# GOOGLE_ADS_API_VERSION=v26
# META_GRAPH_VERSION=v26.0
# LINKEDIN_API_VERSION=202610
# X_ADS_API_VERSION=12

# ---------------------------------------------------------------------------
# PPS Books — `pps books serve` (see docs/books.md)
# ---------------------------------------------------------------------------

# Where the database, attachments and session key live.
BOOKS_DATA_DIR=books-data

# The address customers and Stripe reach (pay links in emails, the webhook). Use https:// in production.
BOOKS_BASE_URL=http://localhost:5080

# Optional: a database URL instead of SQLite in the data folder.
# BOOKS_DATABASE_URL=

# Stripe: secret (or restricted) key and the signing secret of the webhook at <BOOKS_BASE_URL>/stripe/webhook.
# Keys saved under Settings → Payments are used when these are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Outgoing email for invoices, statements and reminders. Empty: emails wait in the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Claude model for categorizing bank transactions and reading receipts (uses ANTHROPIC_API_KEY above).
BOOKS_AI_MODEL=claude-opus-5-5
